# Insight Vault configuration.
#
#   1. Copy this file to ".env" (npm run setup does it for you) and edit the copy.
#   2. ".env" is git-ignored. Never commit it: it holds your secrets.
#   3. Real environment variables win over values in this file.
#   4. A wrong value stops the app at startup with a message naming every problem.
#
# Everything below is optional unless marked REQUIRED. Values shown are the defaults.

# =============================================================== LLM
# Which backend talks to the model:
#   none               LLM off. Everything works with built-in rules only.
#   litellm            Any model LiteLLM supports (needs: pip install -r requirements-litellm.txt)
#   openrouter         OpenRouter directly over HTTP (no extra install)
#   openai_compatible  Any OpenAI-style server: Ollama, vLLM, LM Studio, a company gateway
# If you only set LLM_MODEL, the provider defaults to litellm.
LLM_PROVIDER=none
# REQUIRED when the provider is not "none". Examples:
#   openrouter:         anthropic/claude-sonnet-4.5     (any model id from openrouter.ai/models)
#   litellm:            openrouter/anthropic/claude-sonnet-4.5   or   gpt-4o   or   ollama/llama3
#   openai_compatible:  llama3.1:8b
LLM_MODEL=
# Your provider key. LiteLLM also reads the provider's own variable (OPENROUTER_API_KEY, OPENAI_API_KEY, ...).
LLM_API_KEY=
# Custom endpoint. REQUIRED for openai_compatible (e.g. http://localhost:11434/v1). Optional otherwise.
LLM_BASE_URL=
# Models to try, in order, if the main one fails. Format provider:model, comma separated.
# Example: litellm:gpt-4o-mini,openai_compatible:llama3.1:8b
LLM_FALLBACKS=
# Use a different model per task (empty = LLM_MODEL). Handy: a cheap model to classify, a strong one to write.
LLM_MODEL_CLASSIFY=
LLM_MODEL_INSIGHTS=
LLM_MODEL_SUMMARY=
# Generation controls
LLM_TEMPERATURE=0.2
LLM_VOTE_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=4
# How many times an ambiguous ticket is sent to the model; the majority answer wins.
LLM_VOTES=3
# Stop calling a failing model after this many failures, for this many seconds.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_RESET=30
# Spending guard: maximum tokens per day across all calls. 0 = unlimited.
LLM_DAILY_TOKEN_CAP=0
# Replace e-mail addresses, phone numbers and card-like numbers with placeholders before sending text out.
LLM_PII_MASKING=false
# Folder with classify.txt / insights.txt / summary.txt to replace the built-in prompts.
PROMPT_DIR=
# Language for generated summaries and insights.
OUTPUT_LANGUAGE=English
# OpenRouter attribution headers (optional).
OPENROUTER_REFERER=
OPENROUTER_TITLE=Insight Vault
# Result cache
CACHE_TTL=3600
CACHE_SIZE=512

# =============================================================== Support reports and rules
# Your own issue categories and fix patterns (copy config/rules.yaml and edit). Empty = built-in.
RULES_FILE=
# Your own Markdown report layout (copy config/report_template.md and edit). Empty = built-in.
REPORT_TEMPLATE=
# A ticket is decided by rules (no LLM) when its best category has at least this many keyword hits
# and leads the runner-up by at least this margin.
RULE_MIN_HITS=2
RULE_MIN_MARGIN=2
# Choices in the "last X days" dropdown (ascending) and which one is selected first.
REPORT_WINDOWS=7,14,30,60,90
REPORT_DEFAULT_DAYS=30

# =============================================================== Sign-in
# none    Single local user, no login. For one person on one machine.
# apikey  Scripts send "Authorization: Bearer <key>"; there is no browser login.
# sso     Browser login with Google / LinkedIn / Microsoft / your own OIDC provider.
AUTH_MODE=none
# Keys for scripts. Format name:role:key, comma separated. Roles: viewer, editor, approver, admin.
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# --- sso settings ---
# REQUIRED for sso: a long random string that signs session cookies (32+ characters).
SECRET_KEY=
# The address people type in the browser. Used to build the sign-in return address.
PUBLIC_URL=http://localhost:3000
SESSION_HOURS=12
# Set true when served over https.
COOKIE_SECURE=false
# Access is DENIED BY DEFAULT. REQUIRED for sso: list who may sign in, by e-mail and/or company domain.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
# Roles by e-mail (these addresses are allowed in automatically). Everyone else gets DEFAULT_ROLE.
#   viewer = read only; editor = change data; approver = also approve reports; admin = everything incl. settings
ADMIN_EMAILS=
APPROVER_EMAILS=
EDITOR_EMAILS=
DEFAULT_ROLE=viewer
# Allow people to approve the reports they created themselves (ignored in AUTH_MODE=none).
ALLOW_SELF_APPROVAL=false
# --- identity providers: fill in the ones you want. Each needs an app registered with that provider. ---
# Redirect URI to register with every provider: <PUBLIC_URL>/api/auth/callback/<provider>
#   e.g. http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn: add the "Sign In with LinkedIn using OpenID Connect" product to your LinkedIn app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Microsoft: MICROSOFT_TENANT must be YOUR tenant id or domain (not common / organizations / consumers).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=
# Any other OpenID Connect provider (Okta, Auth0, Keycloak, ...). Redirect URI ends in /oidc.
OIDC_NAME=Company SSO
OIDC_METADATA_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# =============================================================== Server and security
HOST=127.0.0.1
PORT=5001
THREADS=8
# text or json (json suits log collectors)
LOG_FORMAT=text
LOG_LEVEL=INFO
# Where data is stored. Empty = data/db.json inside the project.
DATA_FILE=
MAX_BODY_MB=10
# Browser origins allowed to call the API directly (comma separated). Empty = same-origin only.
CORS_ORIGINS=
# Number of reverse proxies in front of the API whose X-Forwarded-For header you trust (0 = none).
TRUST_PROXY=0
# Requests per minute per client. 0 = off. The LLM limit covers endpoints that call the model.
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_LLM_PER_MINUTE=0
# How many audit-log entries to keep.
AUDIT_RETENTION=5000

# =============================================================== Look and feel
APP_NAME=Insight Vault
ACCENT_COLOR=#4f46e5
# system, light or dark (people can still switch for themselves)
DEFAULT_THEME=system
# Which parts to show. "notes" must stay. Options: notes, insights, search, support, ai_suggestions
FEATURES=notes,insights,search,support,ai_suggestions
# Date format language, e.g. en-GB, de-DE.
LOCALE=en-US
