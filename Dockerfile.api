# Insight Vault API (Python). Build: docker compose build   Optional LiteLLM: WITH_LITELLM=true docker compose build
FROM python:3.12-slim

ARG WITH_LITELLM=false
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app

COPY requirements.txt requirements-litellm.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ "$WITH_LITELLM" = "true" ]; then pip install --no-cache-dir -r requirements-litellm.txt; fi

COPY backend backend
COPY config config
COPY samples samples

# Run as an unprivileged user; data lives on a volume.
RUN useradd --system --uid 10001 app && mkdir /data && chown app /data
USER app
ENV HOST=0.0.0.0 PORT=5001 DATA_FILE=/data/db.json
VOLUME /data
EXPOSE 5001

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5001/api/ready', timeout=4)"

CMD ["python", "-m", "backend"]
